{
  "name": "graphixxx",
  "version": "0.1.0",
  "dependencies": [
    "glfw3",
    "glad",
    {
      "name": "imgui",
      "features": ["glfw-binding", "opengl3-binding"]
    },
    "stb",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "swscale", "x264", "gpl"]
    }
  ]
}
